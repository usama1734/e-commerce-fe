# Frontend (Vite) — copy to `.env.development` or `.env.local` and adjust.
# https://vite.dev/guide/env-and-mode.html
#
# Production / Vercel: the API base is resolved at **build** time in vite.config.js from the
# first non-empty value among (then redeploy):
#   VITE_API_BASE_URL, VITE_BACKEND_URL, BACKEND_URL, BACKEND_PUBLIC_URL
# If you use BACKEND_URL with only an origin (no path), /api is appended automatically.

# Axios base URL (local dev: `/api` + Vite proxy).
VITE_API_BASE_URL=/api

# Dev server only: where Vite proxies `/api` (see vite.config.js). Not bundled into the app.
VITE_API_PROXY_TARGET=http://127.0.0.1:4000
