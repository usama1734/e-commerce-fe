# Frontend (Vite) — copy to `.env.development` or `.env.local` and adjust.
# https://vite.dev/guide/env-and-mode.html
#
# Only variables prefixed with VITE_ are exposed to client code (import.meta.env).

# Axios base URL.
# - Local dev: `/api` is fine (Vite proxies to VITE_API_PROXY_TARGET).
# - Vercel / production: MUST be the full backend URL, e.g. `https://your-api.up.railway.app/api`
#   Add the same key in Vercel → Settings → Environment Variables (Production + Preview),
#   then redeploy — Vite bakes this in at build time; `NEXT_PUBLIC_*` will NOT work.
VITE_API_BASE_URL=/api

# Dev server only: where Vite proxies `/api` (see vite.config.js). Not bundled into the app.
VITE_API_PROXY_TARGET=http://127.0.0.1:4000
