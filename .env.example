# Frontend (Vite) — copy to `.env.development`, `.env.local`, or `.env.production` and adjust.
# https://vite.dev/guide/env-and-mode.html
#
# API base URL is resolved at **build** time (`vite.resolveApiBase.js`). Order:
#   1. Each key below from `process.env` (Vercel dashboard / CI)
#   2. Same keys from `.env*` via `loadEnv` — first non-empty wins within each tier.
# Keys (first match wins): VITE_API_BASE_URL, VITE_BACKEND_URL, BACKEND_URL,
#   BACKEND_PUBLIC_URL, VITE_API_URL, API_URL
#
# Local dev: relative `/api` + Vite proxy. Production / Vercel: use an absolute URL, then redeploy.
# If the URL has only an origin (path `/`), `/api` is appended automatically.

# Axios base URL (local dev).
VITE_API_BASE_URL=/api

# Dev server only: proxy target for `/api`. Not injected into the client bundle.
VITE_API_PROXY_TARGET=http://127.0.0.1:4000

# --- Production examples (uncomment one approach on your host; do not commit secrets) ---
# Full API prefix (preferred when paths are explicit):
# VITE_API_BASE_URL=https://your-api.example.com/api
#
# Or backend origin only (resolver adds `/api` when path is `/`):
# BACKEND_URL=https://your-api.example.com
#
# Aliases also supported at build time:
# VITE_BACKEND_URL=https://your-api.example.com
# BACKEND_PUBLIC_URL=https://your-api.example.com
# VITE_API_URL=https://your-api.example.com/api
# API_URL=https://your-api.example.com/api
